{
  "openapi": "3.1.1",
  "info": {
    "title": "Fibotrail API",
    "version": "v1"
  },
  "paths": {
    "/api/session": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/immich": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetImmichStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImmichStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/scan": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetScanStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "StartScan",
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStatus"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/photos/{id}/thumbnail": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetPhotoThumbnail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/photos/{id}/preview": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetPhotoPreview",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/home": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetHome",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeState"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "SetHome",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetHomeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetHomeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/home/places": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "SearchHomePlaces",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlaceInfo"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HomeState": {
        "required": [
          "confirmed",
          "suggestion",
          "hasPositions",
          "photoCount"
        ],
        "type": "object",
        "properties": {
          "confirmed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PlaceInfo"
              }
            ]
          },
          "suggestion": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HomeSuggestionInfo"
              }
            ]
          },
          "hasPositions": {
            "type": "boolean"
          },
          "photoCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HomeSuggestionInfo": {
        "required": [
          "latitude",
          "longitude",
          "name",
          "days"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string"
          },
          "days": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ImmichStatus": {
        "required": [
          "connected",
          "version",
          "message",
          "warning"
        ],
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "warning": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PlaceInfo": {
        "required": [
          "latitude",
          "longitude",
          "name"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ProblemDetail": {
        "required": [
          "detail"
        ],
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "ScanStatus": {
        "required": [
          "state",
          "done",
          "total",
          "message",
          "finishedAt",
          "photoCount"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/ScanStatusState"
          },
          "done": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "photoCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ScanStatusState": {
        "enum": [
          "never",
          "running",
          "completed",
          "failed"
        ]
      },
      "SessionInfo": {
        "required": [
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "SetHomeRequest": {
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SetHomeResponse": {
        "required": [
          "home",
          "trips",
          "newSuggestions"
        ],
        "type": "object",
        "properties": {
          "home": {
            "$ref": "#/components/schemas/PlaceInfo"
          },
          "trips": {
            "type": "integer",
            "format": "int32"
          },
          "newSuggestions": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Fibotrail"
    }
  ]
}
