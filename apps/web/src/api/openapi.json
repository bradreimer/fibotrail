{
  "openapi": "3.1.1",
  "info": {
    "title": "Fibotrail API",
    "version": "v1"
  },
  "paths": {
    "/api/session": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/immich": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetImmichStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImmichStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/scan": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetScanStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "StartScan",
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStatus"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/photos/{id}/thumbnail": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetPhotoThumbnail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/photos/{id}/preview": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetPhotoPreview",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/home": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetHome",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeState"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "SetHome",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetHomeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetHomeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/home/places": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "SearchHomePlaces",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlaceInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/inbox": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetInbox",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inbox"
                }
              }
            }
          }
        }
      }
    },
    "/api/inbox/count": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetInboxCount",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboxCount"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{id}/photos": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetTripPhotos",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PhotoInfo"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/trips/{id}/decision": {
      "post": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "DecideTrip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips": {
      "get": {
        "tags": [
          "Fibotrail"
        ],
        "operationId": "GetTrips",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TripSummary"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecisionAction": {
        "enum": [
          "add",
          "ignore",
          "later",
          "restore"
        ]
      },
      "DecisionRequest": {
        "required": [
          "action"
        ],
        "type": "object",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/DecisionAction"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "coverPhotoId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HomeState": {
        "required": [
          "confirmed",
          "suggestion",
          "hasPositions",
          "photoCount"
        ],
        "type": "object",
        "properties": {
          "confirmed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PlaceInfo"
              }
            ]
          },
          "suggestion": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HomeSuggestionInfo"
              }
            ]
          },
          "hasPositions": {
            "type": "boolean"
          },
          "photoCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HomeSuggestionInfo": {
        "required": [
          "latitude",
          "longitude",
          "name",
          "days"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string"
          },
          "days": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ImmichStatus": {
        "required": [
          "connected",
          "version",
          "message",
          "warning"
        ],
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "warning": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Inbox": {
        "required": [
          "suggestions",
          "ignored",
          "count"
        ],
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            }
          },
          "ignored": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            }
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "InboxCount": {
        "required": [
          "count"
        ],
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PhotoInfo": {
        "required": [
          "id",
          "alt",
          "isVideo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "isVideo": {
            "type": "boolean"
          }
        }
      },
      "PlaceInfo": {
        "required": [
          "latitude",
          "longitude",
          "name"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ProblemDetail": {
        "required": [
          "detail"
        ],
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "RoutePoint": {
        "required": [
          "latitude",
          "longitude",
          "photoCount"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "photoCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ScanStatus": {
        "required": [
          "state",
          "done",
          "total",
          "message",
          "finishedAt",
          "photoCount"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/ScanStatusState"
          },
          "done": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "photoCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ScanStatusState": {
        "enum": [
          "never",
          "running",
          "completed",
          "failed"
        ]
      },
      "SessionInfo": {
        "required": [
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "SetHomeRequest": {
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SetHomeResponse": {
        "required": [
          "home",
          "trips",
          "newSuggestions"
        ],
        "type": "object",
        "properties": {
          "home": {
            "$ref": "#/components/schemas/PlaceInfo"
          },
          "trips": {
            "type": "integer",
            "format": "int32"
          },
          "newSuggestions": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Suggestion": {
        "required": [
          "id",
          "status",
          "name",
          "place",
          "places",
          "startDate",
          "endDate",
          "photoCount",
          "confidence",
          "coverPhotoId",
          "strip",
          "route"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/TripStatus"
          },
          "name": {
            "type": "string"
          },
          "place": {
            "type": [
              "null",
              "string"
            ]
          },
          "places": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "photoCount": {
            "type": "integer",
            "format": "int32"
          },
          "confidence": {
            "$ref": "#/components/schemas/TripConfidence"
          },
          "coverPhotoId": {
            "type": "string"
          },
          "strip": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhotoInfo"
            }
          },
          "route": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoutePoint"
            }
          }
        }
      },
      "TripConfidence": {
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "TripStatus": {
        "enum": [
          "suggested",
          "added",
          "ignored",
          "later"
        ]
      },
      "TripSummary": {
        "required": [
          "id",
          "name",
          "startDate",
          "endDate",
          "days",
          "place",
          "coverPhotoId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "integer",
            "format": "int32"
          },
          "place": {
            "type": [
              "null",
              "string"
            ]
          },
          "coverPhotoId": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Fibotrail"
    }
  ]
}
