# Copy this file to .env and fill in the values. Never commit .env.
# Variables that hold a secret are left empty here.

# Address of the Immich server, as seen from the Fibotrail container.
IMMICH_URL=http://immich_server:2283

# Address of Immich as your browser reaches it. Fibotrail uses it only to build "Open in Immich"
# links. Leave it empty to hide those links.
IMMICH_EXTERNAL_URL=https://photos.example.com

# Seconds to wait for one Immich request before the request fails and is retried.
IMMICH_TIMEOUT_SECONDS=30

# Immich API key with read permissions only: asset.read, asset.view, album.read, asset.statistics.
IMMICH_API_KEY=

# Time zone used for the scan schedule and for logs.
TZ=America/Vancouver
